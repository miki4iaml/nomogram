cff-version: 1.2.0
message: "If you use this software, please cite it as below."
type: software
title: nomogram
abstract: >-
  A repository of scientific formulas: alternative notations across
  authors and conventions, parameter units (including empirical ones),
  validity domains, LaTeX rendering and symbolic computation.
authors:
  - alias: Miki
version: 0.5.0
date-released: "2026-10-31"
doi: 10.5281/zenodo.23373134
license: BSD-3-Clause
repository-code: "https://github.com/miki4iaml/nomogram"
# The data bundled in the package (src/nomogram/data/NOTICE.md).
references:
  - type: data
    title: "QUDT — Quantities, Units, Dimensions and Types"
    authors:
      - name: "QUDT.org"
        website: "https://qudt.org"
    version: "3.5.2"
    url: "https://qudt.org"
    repository-code: "https://github.com/qudt/qudt-public-repo"
    license: CC-BY-4.0
  - type: data
    title: "CF Standard Name Table"
    authors:
